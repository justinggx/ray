<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Noto+Serif+SC:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0908;
  --bg-2:#12100f;
  --panel:#141211;
  --panel-2:#191614;
  --line:rgba(215,188,127,.22);
  --line-strong:rgba(215,188,127,.45);
  --gold:#d7bc7f;
  --gold-2:#b99146;
  --gold-soft:rgba(215,188,127,.10);
  --text:#f4efe7;
  --text-2:#d5c9b8;
  --text-3:#9e917f;
  --wine:#5b232d;
  --shadow:0 20px 60px rgba(0,0,0,.45);
  --radius:22px;
  --radius-sm:14px;
  --max:1440px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:
    radial-gradient(circle at 12% 10%, rgba(91,35,45,.18), transparent 28%),
    radial-gradient(circle at 90% 18%, rgba(215,188,127,.10), transparent 24%),
    linear-gradient(180deg,#090807 0%, #0e0c0b 28%, #0b0a09 100%);
  color:var(--text);
  font-family:"Noto Serif SC", serif;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(rgba(255,255,255,.015), rgba(255,255,255,0)),
    repeating-linear-gradient(
      90deg,
      rgba(255,255,255,.012) 0,
      rgba(255,255,255,.012) 1px,
      transparent 1px,
      transparent 120px
    );
  mix-blend-mode:screen;
  opacity:.35;
}
img{display:block;max-width:100%}
button{font:inherit}
.page{
  width:min(var(--max), calc(100% - 32px));
  margin:0 auto;
}

/* HERO */
.hero{
  position:relative;
  min-height:760px;
  display:grid;
  align-items:end;
  padding:42px 0 20px;
}
.hero-shell{
  position:relative;
  min-height:680px;
  border:1px solid var(--line);
  border-radius:28px;
  overflow:visible;
  background:#120f0d;
  box-shadow:var(--shadow);
}
.hero-media{
  position:absolute;
  inset:0;
  border-radius:28px;
  overflow:hidden;
  background:
    linear-gradient(180deg, rgba(0,0,0,.00) 0%, rgba(0,0,0,.10) 45%, rgba(0,0,0,.65) 78%, rgba(8,7,6,.96) 100%),
    linear-gradient(90deg, rgba(8,7,6,.60) 0%, rgba(8,7,6,.10) 30%, rgba(8,7,6,.02) 55%, rgba(8,7,6,.28) 100%),
    url('https://i.postimg.cc/259JxCRj/IMG-4059(20260321-220627).jpg') 95% 0% / 130% auto no-repeat;
  transform:scale(1.02);
}
.hero-noise{
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 78% 20%, rgba(215,188,127,.16), transparent 18%),
    radial-gradient(circle at 20% 78%, rgba(91,35,45,.22), transparent 24%);
  mix-blend-mode:screen;
  pointer-events:none;
}
.hero-grid{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
  gap:28px;
  align-items:end;
  height:100%;
  padding:46px 46px 34px;
}
.hero-copy{
  align-self:end;
  max-width:760px;
}
.hero-kicker{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:8px 14px;
  border:1px solid var(--line);
  border-radius:999px;
  background:rgba(10,9,8,.42);
  color:var(--gold);
  font-family:"Inter",sans-serif;
  font-size:12px;
  font-weight:600;
  letter-spacing:.22em;
  text-transform:uppercase;
  backdrop-filter:blur(10px);
}
.hero-kicker::before{
  content:"";
  width:8px;height:8px;border-radius:50%;
  background:var(--gold);
  box-shadow:0 0 0 6px rgba(215,188,127,.12);
}
.hero-title{
  margin:22px 0 10px;
  font-family:"Cormorant Garamond", serif;
  font-size:clamp(3.2rem, 7vw, 6.3rem);
  line-height:.92;
  font-weight:700;
  letter-spacing:.03em;
  text-transform:uppercase;
  text-shadow:0 8px 32px rgba(0,0,0,.35);
}
.hero-title .cn{
  display:block;
  margin-top:10px;
  font-family:"Noto Serif SC",serif;
  font-size:clamp(1rem, 2vw, 1.35rem);
  font-weight:500;
  letter-spacing:.45em;
  color:var(--gold);
  text-shadow:0 1px 6px rgba(0,0,0,.90), 0 2px 16px rgba(0,0,0,.80);
}
.hero-desc{
  max-width:700px;
  margin:18px 0 0;
  color:#f0e8da;
  font-size:1rem;
  line-height:1.9;
  text-shadow:0 1px 4px rgba(0,0,0,.95), 0 2px 16px rgba(0,0,0,.85), 0 0px 32px rgba(0,0,0,.70);
}
.hero-meta{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:24px;
}
.hero-chip{
  padding:8px 14px;
  border-radius:999px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.10);
  color:var(--text-2);
  font-size:.84rem;
  letter-spacing:.04em;
  backdrop-filter:blur(8px);
}
.hero-side{
  align-self:start;
  justify-self:end;
  width:100%;
  display:flex;
  flex-direction:column;
  gap:16px;
}
.hero-card{
  background:linear-gradient(180deg, rgba(20,18,17,.80), rgba(12,11,10,.92));
  border:1px solid var(--line);
  border-radius:24px;
  padding:22px 22px 20px;
  backdrop-filter:blur(14px);
  box-shadow:0 20px 50px rgba(0,0,0,.35);
}
.hero-card h3{
  margin:0 0 12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  font-size:.95rem;
  font-weight:600;
  color:var(--gold);
  letter-spacing:.16em;
  text-transform:uppercase;
  font-family:"Inter",sans-serif;
}
.hero-card p{
  margin:0;
  color:var(--text-2);
  line-height:1.8;
  font-size:.93rem;
}
.profile-list{
  display:grid;
  gap:12px;
}
.profile-row{
  display:grid;
  grid-template-columns:78px 1fr;
  gap:12px;
  align-items:start;
  padding:0 0 12px;
  border-bottom:1px dashed rgba(215,188,127,.14);
}
.profile-row:last-child{border-bottom:none;padding-bottom:0}
.profile-label{
  color:var(--text-3);
  font-size:.78rem;
  letter-spacing:.18em;
  text-transform:uppercase;
  font-family:"Inter",sans-serif;
}
.profile-value{
  color:var(--text);
  font-size:.96rem;
  line-height:1.75;
}
.hero-quote{
  font-family:"Cormorant Garamond",serif;
  font-size:1.5rem;
  line-height:1.35;
  color:#f3e8d2;
}
.hero-quote small{
  display:block;
  margin-top:10px;
  color:var(--text-3);
  font-size:.82rem;
  letter-spacing:.14em;
  text-transform:uppercase;
  font-family:"Inter",sans-serif;
}

/* FILTER INSIDE HERO */
.filter-inline{
  position:relative;
  z-index:3;
  margin:0 46px 0;
}
.filter-bar{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:12px;
  padding:16px;
  border:1px solid var(--line);
  border-radius:24px;
  background:rgba(13,11,10,.78);
  backdrop-filter:blur(18px);
  box-shadow:0 18px 40px rgba(0,0,0,.28);
}
.filter-main{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  width:100%;
}
.filter-sub{
  display:none;
  width:100%;
  padding-top:8px;
  margin-top:2px;
  border-top:1px solid rgba(215,188,127,.12);
  gap:10px;
  flex-wrap:wrap;
  animation:fadeDown .22s ease;
}
.filter-sub.vis{
  display:flex;
}
@keyframes fadeDown{
  from{opacity:0;transform:translateY(-6px)}
  to{opacity:1;transform:translateY(0)}
}
.fbtn,
.sbtn{
  position:relative;
  border:1px solid rgba(215,188,127,.16);
  background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.01));
  color:var(--text-2);
  border-radius:999px;
  padding:8px 14px;
  cursor:pointer;
  transition:.26s ease;
  overflow:hidden;
  white-space:nowrap;
}
.fbtn{
  font-size:.8rem;
  font-weight:600;
  letter-spacing:.06em;
}
.sbtn{
  font-size:.74rem;
  padding:7px 12px;
  color:var(--text-3);
}
.fbtn::before,
.sbtn::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(120deg, transparent 0%, rgba(255,255,255,.06) 35%, transparent 70%);
  transform:translateX(-140%);
  transition:transform .7s ease;
}
.fbtn:hover,
.sbtn:hover{
  color:var(--gold);
  border-color:rgba(215,188,127,.36);
  transform:translateY(-1px);
}
.fbtn:hover::before,
.sbtn:hover::before{
  transform:translateX(140%);
}
.fbtn.on,
.sbtn.on{
  color:#1a1309;
  background:linear-gradient(180deg, #e7d3a4, #c89b53);
  border-color:rgba(255,230,179,.55);
  box-shadow:0 8px 24px rgba(201,145,63,.18);
}

/* SECTION COMMON */
.section-block{
  margin-top:26px;
}
.section-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:18px;
  margin-bottom:18px;
}
.section-title{
  margin:10px 0 0;
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(2rem, 4vw, 3rem);
  line-height:1;
  letter-spacing:.03em;
  color:#f6efdf;
}
.section-sub{
  margin:12px 0 0;
  color:var(--text-3);
  font-size:.94rem;
  line-height:1.9;
}

/* INTRO GRID */
.editorial{
  display:grid;
  grid-template-columns:minmax(0, 1.15fr) minmax(320px, .85fr);
  gap:28px;
  margin-top:24px;
  padding:0 46px;
}
.panel{
  position:relative;
  background:linear-gradient(180deg, rgba(20,18,17,.96), rgba(14,12,11,.98));
  border:1px solid var(--line);
  border-radius:26px;
  box-shadow:var(--shadow);
}
.panel::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:inherit;
  pointer-events:none;
  background:linear-gradient(180deg, rgba(255,255,255,.02), transparent 28%);
}
.panel-inner{position:relative; z-index:1; padding:26px}
.eyebrow{
  display:flex;
  align-items:center;
  gap:10px;
  color:var(--gold);
  font-family:"Inter",sans-serif;
  font-size:.78rem;
  font-weight:700;
  letter-spacing:.22em;
  text-transform:uppercase;
  margin-bottom:6px;
}
.eyebrow::before{
  content:"";
  width:26px;height:1px;background:var(--gold);
}
.info-grid{
  display:grid;
  grid-template-columns:repeat(2, minmax(0,1fr));
  gap:14px;
  margin-top:18px;
}
.info-card{
  padding:16px 18px;
  border:1px solid rgba(215,188,127,.12);
  border-radius:18px;
  background:rgba(255,255,255,.02);
}
.info-card h4{
  margin:0 0 8px;
  color:var(--text-3);
  font-size:.74rem;
  letter-spacing:.18em;
  text-transform:uppercase;
  font-family:"Inter",sans-serif;
}
.info-card p{
  margin:0;
  color:var(--text);
  line-height:1.9;
  font-size:.94rem;
}
.guide-list{
  display:grid;
  gap:12px;
  margin-top:20px;
}
.guide-item{
  display:grid;
  grid-template-columns:34px 1fr;
  gap:14px;
  align-items:start;
}
.guide-num{
  width:34px;height:34px;border-radius:50%;
  border:1px solid rgba(215,188,127,.28);
  color:var(--gold);
  display:flex;align-items:center;justify-content:center;
  font-family:"Inter",sans-serif;
  font-size:.82rem;font-weight:700;
  background:rgba(215,188,127,.06);
}
.guide-text{
  color:var(--text-2);
  line-height:1.9;
  font-size:.94rem;
}
.note-stack{
  display:grid;
  gap:12px;
  margin-top:18px;
}
.note-line{
  display:flex;
  gap:10px;
  align-items:flex-start;
  padding:14px 16px;
  border:1px solid rgba(215,188,127,.12);
  border-radius:16px;
  background:rgba(255,255,255,.02);
}
.note-tag{
  flex-shrink:0;
  min-width:54px;
  text-align:center;
  padding:5px 10px;
  border-radius:999px;
  font-size:.72rem;
  letter-spacing:.12em;
  text-transform:uppercase;
  font-family:"Inter",sans-serif;
  font-weight:700;
}
.note-tag.allow{
  color:#1c1308;
  background:linear-gradient(180deg,#ead9b0,#cc9c53);
}
.note-tag.deny{
  color:#f3dede;
  background:rgba(123,39,54,.56);
  border:1px solid rgba(179,88,107,.28);
}
.note-content{
  color:var(--text-2);
  line-height:1.9;
  font-size:.92rem;
}
.tag-cloud{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:20px;
}
.tag{
  padding:8px 12px;
  border-radius:999px;
  border:1px solid rgba(215,188,127,.16);
  background:rgba(255,255,255,.02);
  color:var(--text-2);
  font-size:.8rem;
}

/* CHANGELOG */
.changelog{
  margin-top:18px;
  display:grid;
  gap:10px;
}
.log-item{
  border:1px solid rgba(215,188,127,.12);
  border-radius:18px;
  background:rgba(255,255,255,.02);
  overflow:hidden;
  transition:.25s ease;
}
.log-item:hover{
  border-color:rgba(215,188,127,.24);
}
.log-header{
  display:flex;
  align-items:center;
  gap:14px;
  padding:16px 18px;
  cursor:pointer;
}
.log-icon{
  width:28px;height:28px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  border:1px solid rgba(215,188,127,.22);
  color:var(--gold);
  font-size:.82rem;
  flex-shrink:0;
}
.log-item.collapsed .log-icon{transform:rotate(-90deg)}
.log-date{
  color:var(--gold);
  font-family:"Inter",sans-serif;
  font-size:.8rem;
  font-weight:700;
  letter-spacing:.14em;
  min-width:92px;
}
.log-summary{
  color:var(--text-2);
  font-size:.92rem;
  line-height:1.7;
}
.log-item.expanded .log-summary{display:none}
.log-details{
  max-height:0;
  overflow:hidden;
  opacity:0;
  transition:max-height .35s ease, opacity .25s ease, padding .25s ease;
}
.log-item.expanded .log-details{
  max-height:900px;
  opacity:1;
  padding:0 18px 18px 60px;
}
.log-content{
  display:grid;
  gap:8px;
  color:var(--text-2);
  font-size:.9rem;
  line-height:1.75;
}
.log-point{
  display:grid;
  grid-template-columns:24px 1fr;
  gap:10px;
}
.log-point-num{color:var(--gold)}
.log-more{
  margin-top:4px;
  text-align:center;
}
.log-more-btn{
  padding:9px 18px;
  border-radius:999px;
  border:1px solid rgba(215,188,127,.2);
  background:transparent;
  color:var(--text-2);
  cursor:pointer;
  transition:.25s ease;
}
.log-more-btn:hover{
  color:var(--gold);
  border-color:rgba(215,188,127,.36);
}
.log-archive{display:none}

/* SECTIONS */
.sec{
  margin-top:0;
}
.sec h2{
  margin:0 0 12px;
  font-family:"Cormorant Garamond",serif;
  font-size:1.7rem;
  font-weight:600;
  color:#f6efdf;
  letter-spacing:.03em;
}
.grid{
  display:grid;
  grid-template-columns:repeat(2, minmax(0,1fr));
  gap:14px;
}
.card{
  position:relative;
  background:linear-gradient(180deg, rgba(20,18,17,.98), rgba(12,11,10,.98));
  border:1px solid var(--line);
  border-radius:26px;
  overflow:hidden;
  box-shadow:var(--shadow);
  display:flex;
  flex-direction:column;
}
.card::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:inherit;
  pointer-events:none;
  background:linear-gradient(180deg, rgba(255,255,255,.02), transparent 24%);
  z-index:0;
}
.cov{
  position:relative;
  aspect-ratio:3/2;
  overflow:hidden;
  cursor:pointer;
  isolation:isolate;
}
.cov::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(180deg, rgba(0,0,0,.06), rgba(0,0,0,.18) 40%, rgba(0,0,0,.72) 100%);
  z-index:1;
}
.cov::after{
  content:"";
  position:absolute;
  inset:auto 0 0 0;
  height:40%;
  background:linear-gradient(180deg, transparent, rgba(12,11,10,.96));
  z-index:1;
}
.cov img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .6s ease, filter .4s ease;
}
.cov:hover img{
  transform:scale(1.06);
  filter:brightness(.92) saturate(1.05);
}
.clbl{
  position:absolute;
  left:14px;
  right:54px;
  bottom:12px;
  z-index:2;
  color:#f8f0df;
  text-shadow:0 6px 20px rgba(0,0,0,.55);
}
.clbl small{
  display:block;
  margin-bottom:4px;
  color:var(--gold);
  font-size:.68rem;
  letter-spacing:.18em;
  text-transform:uppercase;
  font-family:"Inter",sans-serif;
}
.clbl strong{
  display:block;
  font-family:"Cormorant Garamond",serif;
  font-size:1.4rem;
  font-weight:600;
  line-height:1.1;
}
.ctog{
  position:absolute;
  right:12px;
  top:12px;
  z-index:2;
  width:34px;height:34px;
  display:flex;align-items:center;justify-content:center;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.20);
  background:rgba(12,11,10,.45);
  backdrop-filter:blur(10px);
}
.ctog svg{
  width:13px;height:13px;
  stroke:#f8f0df;
  fill:none;
  stroke-width:2.2;
  stroke-linecap:round;
  stroke-linejoin:round;
  transform:rotate(-90deg);
  transition:transform .28s ease;
}
.card.ex .ctog svg{transform:rotate(0)}
.cbody{
  position:relative;
  z-index:1;
  overflow:hidden;
  max-height:0;
  opacity:0;
  padding:0 16px;
  transition:max-height .3s ease, opacity .22s ease, padding .22s ease;
  display:flex;
  flex-direction:column;
  flex:1;
}
.card.ex .cbody{
  opacity:1;
  padding:16px;
}
.ctxt{
  color:var(--text-2);
  line-height:1.85;
  font-size:.86rem;
}
.cft{
  margin-top:auto;
  padding-top:12px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.cnote{
  margin:0;
  min-height:52px;
  padding:10px 12px;
  border-radius:14px;
  border:1px dashed rgba(215,188,127,.28);
  background:rgba(255,255,255,.03);
  color:#f6ddb0;
  font-size:.76rem;
  line-height:1.6;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  gap:3px;
  text-shadow:0 0 8px rgba(215,188,127,.22);
}
.cnote span{
  animation:noteBlink 1.45s ease-in-out infinite;
}
@keyframes noteBlink{
  0%,100%{
    opacity:1;
    text-shadow:0 0 8px rgba(215,188,127,.18);
  }
  50%{
    opacity:.42;
    text-shadow:0 0 16px rgba(215,188,127,.42);
  }
}
.jbtn{
  width:100%;
  border:none;
  border-radius:999px;
  padding:10px 14px;
  cursor:pointer;
  color:#1a1309;
  background:linear-gradient(180deg, #eddcb5, #ca9b54);
  font-family:"Inter",sans-serif;
  font-size:.82rem;
  font-weight:700;
  letter-spacing:.06em;
  transition:.25s ease;
  box-shadow:0 8px 20px rgba(202,155,84,.16);
}
.jbtn:hover{
  transform:translateY(-1px);
  filter:brightness(1.03);
}
.jbtn.is-jumping{
  pointer-events:none;
  transform:scale(.985);
  box-shadow:0 0 0 1px rgba(237,220,181,.28), 0 10px 28px rgba(202,155,84,.30);
  filter:brightness(1.05);
}
.jump-overlay{
  position:fixed;
  inset:0;
  z-index:9999;
  display:flex;
  align-items:center;
  justify-content:center;
  pointer-events:none;
  opacity:0;
  visibility:hidden;
  background:
    radial-gradient(circle at center, rgba(215,188,127,.12) 0%, rgba(215,188,127,.04) 22%, rgba(6,5,4,0) 46%),
    linear-gradient(180deg, rgba(6,5,4,.10) 0%, rgba(6,5,4,.82) 100%);
  transition:opacity .32s ease, visibility 0s linear .32s;
}
.jump-overlay.show{
  opacity:1;
  visibility:visible;
  transition:opacity .32s ease;
}
.jump-overlay-inner{
  position:relative;
  width:min(78vw, 620px);
  padding:30px 26px;
  text-align:center;
  color:#f4dfb4;
  opacity:0;
  transform:translateY(10px) scale(.985);
  transition:opacity .34s ease, transform .44s cubic-bezier(.22,.8,.22,1);
}
.jump-overlay.show .jump-overlay-inner{
  opacity:1;
  transform:translateY(0) scale(1);
}
.jump-overlay-inner::before,
.jump-overlay-inner::after{
  content:"";
  position:absolute;
  left:50%;
  transform:translateX(-50%) scaleX(.86);
  width:min(68vw, 520px);
  height:1px;
  background:linear-gradient(90deg, rgba(215,188,127,0), rgba(215,188,127,.9), rgba(215,188,127,0));
  opacity:.92;
  transition:transform .46s cubic-bezier(.22,.8,.22,1), opacity .3s ease;
}
.jump-overlay-inner::before{ top:0; }
.jump-overlay-inner::after{ bottom:0; }
.jump-overlay.show .jump-overlay-inner::before,
.jump-overlay.show .jump-overlay-inner::after{
  transform:translateX(-50%) scaleX(1);
}
.jump-overlay-sweep{
  position:absolute;
  inset:-18% -10%;
  border-radius:999px;
  background:linear-gradient(110deg, rgba(255,255,255,0) 0%, rgba(255,244,214,.10) 42%, rgba(255,236,188,.42) 50%, rgba(255,244,214,.10) 58%, rgba(255,255,255,0) 100%);
  mix-blend-mode:screen;
  filter:blur(10px);
  opacity:0;
  transform:translateX(-26%) skewX(-18deg);
}
.jump-overlay.show .jump-overlay-sweep{
  animation:jumpSweep .9s cubic-bezier(.22,.8,.22,1) .08s forwards;
}
.jump-overlay-kicker{
  font:600 11px/1 "Inter",sans-serif;
  letter-spacing:.42em;
  text-transform:uppercase;
  color:rgba(244,223,180,.72);
  margin-bottom:14px;
}
.jump-overlay-title{
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(2.6rem, 5.8vw, 4.2rem);
  line-height:1;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:#f5e4bf;
  text-shadow:0 4px 24px rgba(0,0,0,.35);
}
.jump-overlay-sub{
  margin-top:12px;
  font:500 13px/1.7 "Noto Serif SC",serif;
  letter-spacing:.16em;
  color:rgba(244,223,180,.82);
}
@keyframes jumpSweep{
  0%{
    opacity:0;
    transform:translateX(-30%) skewX(-18deg);
  }
  15%{
    opacity:.22;
  }
  50%{
    opacity:.85;
  }
  100%{
    opacity:0;
    transform:translateX(30%) skewX(-18deg);
  }
}
