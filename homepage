  Array.from(slot.children).forEach(el => store.appendChild(el));
  // 收起所有展开的卡片
  document.querySelectorAll('.card.ex').forEach(c=>{
    c.classList.remove('ex');
    setH(c);
  });
}

function clearMainButtons(){
  document.querySelectorAll('.fbtn').forEach(b=>b.classList.remove('on'));
}

function clearSubButtons(){
  document.querySelectorAll('.sbtn').forEach(b=>b.classList.remove('on'));
}

function closeSub(){
  tabooSubBar().classList.remove('vis');
  clearSubButtons();
}

function openSub(){
  tabooSubBar().classList.add('vis');
}

function showLine(key){
  hideAll();
  const slot = document.getElementById('sec-slot');
  const store = document.getElementById('sec-store');
  const target = store.querySelector(`.sec[data-line="${key}"]`);
  if(target) slot.appendChild(target);
}

