  }
}

function isSingle(){
  return matchMedia('(max-width:640px)').matches;
}

function togR(cov){
  const el = cov.closest('.card');
  if(isSingle()){
    const open = !el.classList.contains('ex');
    el.closest('.grid').querySelectorAll('.card.ex').forEach(c=>{
      if(c!==el){ c.classList.remove('ex'); setH(c); }
    });
    el.classList.toggle('ex', open);
    setH(el);
    return;
  }
  const row = el.dataset.row;
  const open = !el.classList.contains('ex');
  const rowCards = Array.from(document.querySelectorAll(`.card[data-row="${row}"]`))
    .filter(c => c.style.display !== 'none');
  rowCards.forEach(c => { c.classList.toggle('ex', open); setH(c); });
}

function hideAll(){
  const slot = document.getElementById('sec-slot');
  const store = document.getElementById('sec-store');
