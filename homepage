/* ── Starfield ── */
(function(){
  const cvs = document.getElementById('star-canvas');
  if(!cvs) return;
  const ctx = cvs.getContext('2d');
  const pg  = cvs.parentElement;

  function resize(){
    cvs.width  = pg.offsetWidth  || 900;
    cvs.height = pg.offsetHeight || 2400;
  }
  resize();
  window.addEventListener('resize', resize);

  function rand(a,b){ return a + Math.random()*(b-a); }

  /* ── 星星类型 ──
     type 0: 普通小星（最多），白/淡金，慢闪
     type 1: 中型星，暖金，中速闪，带十字光芒
     type 2: 亮星（稀少），金白，快闪强光，十字光芒更长  */
  const STARS = [];
  const COUNTS = [200, 40, 12];

  for(let t=0; t<3; t++){
    for(let i=0; i<COUNTS[t]; i++){
      STARS.push({
        x     : rand(0, 1),   // 用比例存，resize 时按比例重算
        y     : rand(0, 1),
        r     : t===0 ? rand(0.35,0.85) : t===1 ? rand(0.7,1.2) : rand(1.1,1.8),
        phase : rand(0, Math.PI*2),
        speed : t===0 ? rand(0.4,1.0) : t===1 ? rand(0.7,1.6) : rand(1.4,2.8),
        peak  : t===0 ? rand(0.30,0.55) : t===1 ? rand(0.45,0.75) : rand(0.70,1.0),
        type  : t,
        // 颜色：0=冷白偏金，1=暖金，2=亮金白
        hue   : t===0
                  ? (Math.random()<0.6
                      ? {r:240,g:230,b:210}  // 暖白
                      : {r:215,g:195,b:150})  // 淡金
                  : t===1
                  ? {r:225,g:195,b:120}       // 暖金
                  : {r:255,g:235,b:180},      // 亮金白
      });
    }
  }

  /* 十字光芒绘制 */
  function drawCross(x, y, len, alpha, col){
    const a = Math.min(alpha, 1);
    // 水平
    const hg = ctx.createLinearGradient(x-len,y, x+len,y);
    hg.addColorStop(0,   `rgba(${col.r},${col.g},${col.b},0)`);
    hg.addColorStop(0.5, `rgba(${col.r},${col.g},${col.b},${a})`);
    hg.addColorStop(1,   `rgba(${col.r},${col.g},${col.b},0)`);
    ctx.beginPath();
    ctx.strokeStyle = hg;
    ctx.lineWidth = 0.8;
    ctx.moveTo(x-len, y); ctx.lineTo(x+len, y);
    ctx.stroke();
    // 垂直
    const vg = ctx.createLinearGradient(x,y-len, x,y+len);
    vg.addColorStop(0,   `rgba(${col.r},${col.g},${col.b},0)`);
    vg.addColorStop(0.5, `rgba(${col.r},${col.g},${col.b},${a})`);
    vg.addColorStop(1,   `rgba(${col.r},${col.g},${col.b},0)`);
    ctx.beginPath();
    ctx.strokeStyle = vg;
    ctx.moveTo(x, y-len); ctx.lineTo(x, y+len);
    ctx.stroke();
  }

  function draw(){
    ctx.clearRect(0,0,cvs.width,cvs.height);
    const t = performance.now()/1000;
    const W = cvs.width, H = cvs.height;

    STARS.forEach(s => {
      const px = s.x * W;
      const py = s.y * H;

      // 呼吸：sin 波，每颗独立相位
      const raw   = Math.sin(t * s.speed + s.phase);       // -1..1
      const norm  = (raw + 1) * 0.5;                        // 0..1
      // 让暗态更暗、亮态更亮（非线性）
      const curve = Math.pow(norm, 2.2);
      const alpha = curve * s.peak;

      if(alpha < 0.005) return; // 太暗就跳过

      const col = s.hue;
      const r   = s.r;

      if(s.type === 0){
        // 小星：只画核心圆点
        const grd = ctx.createRadialGradient(px,py,0, px,py, r*2.5);
        grd.addColorStop(0,   `rgba(${col.r},${col.g},${col.b},${alpha})`);
        grd.addColorStop(0.6, `rgba(${col.r},${col.g},${col.b},${alpha*0.3})`);
        grd.addColorStop(1,   `rgba(${col.r},${col.g},${col.b},0)`);
        ctx.beginPath();
        ctx.arc(px, py, r*2.5, 0, Math.PI*2);
        ctx.fillStyle = grd;
        ctx.fill();

      } else if(s.type === 1){
        // 中型星：圆点 + 短十字
        const grd = ctx.createRadialGradient(px,py,0, px,py, r*3);
        grd.addColorStop(0,   `rgba(${col.r},${col.g},${col.b},${alpha})`);
        grd.addColorStop(0.5, `rgba(${col.r},${col.g},${col.b},${alpha*0.4})`);
        grd.addColorStop(1,   `rgba(${col.r},${col.g},${col.b},0)`);
        ctx.beginPath();
        ctx.arc(px, py, r*3, 0, Math.PI*2);
        ctx.fillStyle = grd;
        ctx.fill();
        drawCross(px, py, r*10, alpha*0.55, col);

      } else {
        // 亮星：大光晕 + 长十字 + 核心白点
        const grd = ctx.createRadialGradient(px,py,0, px,py, r*6);
        grd.addColorStop(0,   `rgba(255,250,235,${alpha})`);
        grd.addColorStop(0.2, `rgba(${col.r},${col.g},${col.b},${alpha*0.7})`);
        grd.addColorStop(0.6, `rgba(${col.r},${col.g},${col.b},${alpha*0.2})`);
        grd.addColorStop(1,   `rgba(${col.r},${col.g},${col.b},0)`);
        ctx.beginPath();
        ctx.arc(px, py, r*6, 0, Math.PI*2);
        ctx.fillStyle = grd;
        ctx.fill();
        drawCross(px, py, r*22, alpha*0.7, col);
        // 核心白点
        ctx.beginPath();
        ctx.arc(px, py, r*0.8, 0, Math.PI*2);
        ctx.fillStyle = `rgba(255,252,240,${alpha})`;
        ctx.fill();
      }
    });

    requestAnimationFrame(draw);
  }

  draw();
})();
</script>
