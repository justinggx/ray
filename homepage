<script>
const tabooCards = () => document.querySelectorAll('[data-sub]');
const tabooSubBar = () => document.getElementById('tabooSubBar');

function setH(card){
  const b = card.querySelector('.cbody');
  if(!b) return;
  if(!card.classList.contains('ex')){
    b.style.maxHeight = '0px';
  } else {
