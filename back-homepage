<!-- v1.2.2 -->
<!DOCTYPE html>
<html>
<head>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 100%;
    background: transparent;
  }
  body {
    padding: 0 0 18px;
    overflow: visible;
  }

  .wrap {
    width: 100%;
    text-align: center;
  }

  .divider {
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(140,100,70,0.3), transparent);
    margin: 1em auto 18px;
  }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    padding: 10px 44px;
    border-radius: 6px;
    cursor: pointer;
    font-family: 'Noto Serif SC', 'Source Han Serif CN', serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 2px;
    color: #3a2e26;
    border: none;
    outline: none;
    transition: transform 0.15s, filter 0.15s;
    background: linear-gradient(180deg, rgba(250,246,240,0.45) 0%, rgba(232,224,210,0.35) 100%);
    box-shadow:
      0 0 0 1px #a08060,
      inset 0 1px 0 rgba(255,255,255,0.5),
      0 2px 8px rgba(120,85,55,0.1);
  }

  .btn::before, .btn::after {
    content: '✦';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.5rem;
    color: #7a6050;
    animation: sparkle 2s ease-in-out infinite;
  }
  .btn::before { left: 18px; animation-delay: 0s; }
  .btn::after  { right: 18px; animation-delay: 1s; }

  @keyframes sparkle {
    0%, 100% { opacity: 0.35; transform: translateY(-50%) scale(1); }
    50% { opacity: 0.8; transform: translateY(-50%) scale(1.4); }
  }

  .btn:hover {
    transform: translateY(-1px);
    background: linear-gradient(180deg, rgba(255,251,244,0.6) 0%, rgba(238,230,216,0.5) 100%);
    box-shadow:
      0 0 0 1px #8a6a50,
      inset 0 1px 0 rgba(255,255,255,0.6),
      0 3px 10px rgba(120,85,55,0.15);
  }
  .btn:active { transform: scale(0.98); filter: brightness(0.95); }
  .btn[disabled] { pointer-events: none; filter: brightness(1.05); }

  #jumpOverlay {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
    background: rgba(6,5,4,.08);
  }
  #jumpOverlay .left,
  #jumpOverlay .right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 52vw;
  }
  #jumpOverlay .left {
    left: 0;
    background: linear-gradient(90deg, rgba(3,2,2,.96) 0%, rgba(8,6,5,.92) 72%, rgba(34,24,14,.72) 100%);
    transform: translateX(-103%);
  }
  #jumpOverlay .right {
    right: 0;
    background: linear-gradient(270deg, rgba(3,2,2,.96) 0%, rgba(8,6,5,.92) 72%, rgba(34,24,14,.72) 100%);
    transform: translateX(103%);
  }
  #jumpOverlay .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(215,188,127,.08) 0%, rgba(12,10,8,.24) 28%, rgba(6,5,4,.72) 72%, rgba(4,3,3,.92) 100%);
    opacity: 0;
  }
  #jumpOverlay .line {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%) scaleY(.18);
    transform-origin: center;
    background: linear-gradient(180deg, rgba(215,188,127,0) 0%, rgba(215,188,127,.92) 18%, rgba(255,240,208,.98) 50%, rgba(215,188,127,.92) 82%, rgba(215,188,127,0) 100%);
    box-shadow: 0 0 18px rgba(215,188,127,.48), 0 0 34px rgba(215,188,127,.22);
    opacity: 0;
  }
  #jumpOverlay .glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(42vw, 420px);
    height: min(42vw, 420px);
    transform: translate(-50%, -50%) scale(.68);
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255,236,188,.22) 0%, rgba(215,188,127,.14) 24%, rgba(215,188,127,.05) 46%, rgba(215,188,127,0) 72%);
    filter: blur(10px);
    opacity: 0;
  }
  #jumpOverlay .sweep {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(120vw, 1600px);
    height: 28px;
    transform: translate(-50%, -50%) rotate(-12deg) scaleX(.35);
    background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,244,214,.06) 36%, rgba(255,236,188,.78) 50%, rgba(255,244,214,.06) 64%, rgba(255,255,255,0) 100%);
    filter: blur(8px);
    opacity: 0;
    mix-blend-mode: screen;
  }

  #jumpOverlay.fx {
    display: block;
    opacity: 1;
    visibility: visible;
  }
  #jumpOverlay.fx .left {
    animation: jumpLeft 420ms cubic-bezier(.76,0,.24,1) forwards;
  }
  #jumpOverlay.fx .right {
    animation: jumpRight 420ms cubic-bezier(.76,0,.24,1) forwards;
  }
  #jumpOverlay.fx .vignette {
    animation: fadeIn 300ms ease forwards;
  }
  #jumpOverlay.fx .line {
    animation: lineIn 280ms cubic-bezier(.22,.8,.22,1) 220ms forwards;
  }
  #jumpOverlay.fx .glow {
    animation: glowIn 360ms cubic-bezier(.22,.8,.22,1) 220ms forwards;
  }
  #jumpOverlay.fx .sweep {
    animation: sweepIn 320ms cubic-bezier(.22,.8,.22,1) 310ms forwards, sweepOut 220ms ease 530ms forwards;
  }

  @keyframes jumpLeft { from { transform: translateX(-103%); } to { transform: translateX(0); } }
  @keyframes jumpRight { from { transform: translateX(103%); } to { transform: translateX(0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lineIn { from { opacity: 0; transform: translateX(-50%) scaleY(.18); } to { opacity: .96; transform: translateX(-50%) scaleY(1); } }
  @keyframes glowIn { from { opacity: 0; transform: translate(-50%, -50%) scale(.68); } to { opacity: .9; transform: translate(-50%, -50%) scale(1); } }
  @keyframes sweepIn { from { opacity: 0; transform: translate(-50%, -50%) rotate(-12deg) scaleX(.35); } to { opacity: 1; transform: translate(-50%, -50%) rotate(-12deg) scaleX(1); } }
  @keyframes sweepOut { from { opacity: 1; } to { opacity: 0; } }
</style>
</head>
<body>
  <div class="wrap">
    <div class="divider"></div>
    <button class="btn" onclick='(async(btn)=>{try{const f=window.setChatMessages??window.parent?.setChatMessages;if(typeof f!=="function"){console.error("setChatMessages unavailable");return;}btn.disabled=true;const o=document.getElementById("jumpOverlay");if(o){o.className="fx";}await new Promise(x=>setTimeout(x,620));await f([{message_id:0,swipe_id:0}]);}catch(e){console.error(e);}finally{const o=document.getElementById("jumpOverlay");if(o){o.className="";o.style.display="none";o.style.opacity="0";o.style.visibility="hidden";}btn.disabled=false;}})(this)'>返回剧情索引</button>
  </div>

  <div id="jumpOverlay" aria-hidden="true">
    <div class="left"></div>
    <div class="right"></div>
    <div class="vignette"></div>
    <div class="line"></div>
    <div class="glow"></div>
    <div class="sweep"></div>
  </div>
</body>
</html>

