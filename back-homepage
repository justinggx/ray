<!-- v1.3.5 -->
<!DOCTYPE html>
<html>
<head>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 0 18px;
  }

  .divider {
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(140,100,70,0.3), transparent);
    margin-top: 1em;
    margin-bottom: 18px;
  }

  .jump-wrap {
    position: relative;
    display: inline-block;
    padding: 12px 18px;
    border-radius: 14px;
    overflow: visible;
  }

  .btn {
    position: relative;
    z-index: 2;
    padding: 10px 44px;
    border-radius: 6px;
    cursor: pointer;
    font-family: 'Noto Serif SC', 'Source Han Serif CN', serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 2px;
    color: #3a2e26;
    border: none;
    outline: none;
    transition: transform 0.15s, filter 0.15s, box-shadow 0.2s ease;
    background: linear-gradient(180deg, rgba(250,246,240,0.45) 0%, rgba(232,224,210,0.35) 100%);
    box-shadow:
      0 0 0 1px #a08060,
      inset 0 1px 0 rgba(255,255,255,0.5),
      0 2px 8px rgba(120,85,55,0.1);
  }

  .btn::before, .btn::after {
    content: '✦';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.5rem;
    color: #7a6050;
    animation: sparkle 2s ease-in-out infinite;
  }
  .btn::before { left: 18px; animation-delay: 0s; }
  .btn::after  { right: 18px; animation-delay: 1s; }

  @keyframes sparkle {
    0%, 100% { opacity: 0.35; transform: translateY(-50%) scale(1); }
    50% { opacity: 0.8; transform: translateY(-50%) scale(1.4); }
  }

  .btn:hover {
    transform: translateY(-1px);
    background: linear-gradient(180deg, rgba(255,251,244,0.6) 0%, rgba(238,230,216,0.5) 100%);
    box-shadow:
      0 0 0 1px #8a6a50,
      inset 0 1px 0 rgba(255,255,255,0.6),
      0 3px 10px rgba(120,85,55,0.15);
  }
  .btn:active { transform: scale(0.98); filter: brightness(0.95); }

  .jump-ring {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 160ms ease, transform 380ms cubic-bezier(.22,.8,.22,1);
  }

  .jump-ring::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 16px;
    background: conic-gradient(
      from 0deg,
      rgba(255,255,255,0) 0deg,
      rgba(255,255,255,0) 250deg,
      rgba(255,248,220,0.18) 285deg,
      rgba(255,255,255,0.95) 316deg,
      rgba(255,235,180,0.85) 336deg,
      rgba(255,255,255,0) 360deg
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 2px;
    filter: blur(0.2px) drop-shadow(0 0 8px rgba(255,245,210,0.45));
    opacity: 0;
  }

  .jump-ring.show {
    opacity: 1;
    transform: scale(1.02);
  }

  .jump-ring.show::before {
    opacity: 1;
    animation: ringOrbit 900ms linear 1;
  }

  .jump-wrap.is-jumping .btn {
    box-shadow:
      0 0 0 1px #b7946e,
      inset 0 1px 0 rgba(255,255,255,0.58),
      0 0 18px rgba(255,240,210,0.18),
      0 4px 14px rgba(120,85,55,0.16);
  }

  @keyframes ringOrbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
</head>
<body>
  <div class="divider"></div>
  <div id="jumpWrap" class="jump-wrap">
    <button class="btn" onclick="(async()=>{try{const f=window.setChatMessages??window.parent?.setChatMessages;const w=document.getElementById('jumpWrap');const o=document.getElementById('jumpRing');if(w)w.className='jump-wrap is-jumping';if(o)o.className='jump-ring show';await new Promise(r=>setTimeout(r,520));if(typeof f==='function')await f([{message_id:0,swipe_id:0}]);}catch(e){console.error(e);}})()" >
      返回剧情索引
    </button>
    <div id="jumpRing" class="jump-ring"></div>
  </div>
</body>
</html>
