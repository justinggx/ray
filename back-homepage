<!-- v1.3.6 -->
<!DOCTYPE html>
<html>
<head>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 0 18px;
  }

  .divider {
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(140,100,70,0.3), transparent);
    margin-top: 1em;
    margin-bottom: 18px;
  }

  .jump-wrap {
    position: relative;
    display: inline-block;
    padding: 14px 20px;
    border-radius: 16px;
    overflow: visible;
  }

  .btn {
    position: relative;
    z-index: 2;
    padding: 10px 44px;
    border-radius: 6px;
    cursor: pointer;
    font-family: 'Noto Serif SC', 'Source Han Serif CN', serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 2px;
    color: #3a2e26;
    border: none;
    outline: none;
    transition: transform 0.15s, filter 0.15s, box-shadow 0.22s ease;
    background: linear-gradient(180deg, rgba(250,246,240,0.45) 0%, rgba(232,224,210,0.35) 100%);
    box-shadow:
      0 0 0 1px #a08060,
      inset 0 1px 0 rgba(255,255,255,0.5),
      0 2px 8px rgba(120,85,55,0.1);
  }

  .btn::before, .btn::after {
    content: '✦';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.5rem;
    color: #7a6050;
    animation: sparkle 2s ease-in-out infinite;
  }
  .btn::before { left: 18px; animation-delay: 0s; }
  .btn::after  { right: 18px; animation-delay: 1s; }

  @keyframes sparkle {
    0%, 100% { opacity: 0.35; transform: translateY(-50%) scale(1); }
    50% { opacity: 0.8; transform: translateY(-50%) scale(1.4); }
  }

  .btn:hover {
    transform: translateY(-1px);
    background: linear-gradient(180deg, rgba(255,251,244,0.6) 0%, rgba(238,230,216,0.5) 100%);
    box-shadow:
      0 0 0 1px #8a6a50,
      inset 0 1px 0 rgba(255,255,255,0.6),
      0 3px 10px rgba(120,85,55,0.15);
  }
  .btn:active { transform: scale(0.98); filter: brightness(0.95); }

  .jump-ring {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 180ms ease, transform 420ms cubic-bezier(.22,.8,.22,1);
  }

  .jump-ring::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(255,247,228,0.95), rgba(255,228,170,0.75));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 2.5px;
    opacity: 0;
    box-shadow:
      0 0 10px rgba(255,244,214,0.45),
      0 0 18px rgba(255,226,156,0.28);
  }

  .jump-ring::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    left: 0;
    top: 0;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255,255,255,0.98) 0%, rgba(255,244,214,0.95) 28%, rgba(255,223,156,0.92) 56%, rgba(255,223,156,0) 78%);
    filter: blur(0.25px) drop-shadow(0 0 8px rgba(255,246,221,0.92)) drop-shadow(0 0 16px rgba(255,227,160,0.65));
    opacity: 0;
    transform: translate(-50%, -50%) scale(.75);
  }

  .jump-ring.show {
    opacity: 1;
    transform: scale(1.03);
  }

  .jump-ring.show::before {
    opacity: 1;
  }

  .jump-ring.show::after {
    opacity: 1;
    animation: orbitDot 650ms linear 1 forwards, pulseDot 260ms ease-in-out 2 alternate;
  }

  .jump-wrap.is-jumping .btn {
    box-shadow:
      0 0 0 1px #c29c73,
      inset 0 1px 0 rgba(255,255,255,0.62),
      0 0 22px rgba(255,241,205,0.26),
      0 0 34px rgba(255,225,150,0.14),
      0 4px 14px rgba(120,85,55,0.16);
  }

  @keyframes orbitDot {
    0%   { left: 0%;   top: 0%;   transform: translate(-50%, -50%) scale(.78); }
    12%  { left: 50%;  top: 0%;   transform: translate(-50%, -50%) scale(1); }
    25%  { left: 100%; top: 0%;   transform: translate(-50%, -50%) scale(.88); }
    37%  { left: 100%; top: 50%;  transform: translate(-50%, -50%) scale(1); }
    50%  { left: 100%; top: 100%; transform: translate(-50%, -50%) scale(.9); }
    62%  { left: 50%;  top: 100%; transform: translate(-50%, -50%) scale(1); }
    75%  { left: 0%;   top: 100%; transform: translate(-50%, -50%) scale(.88); }
    87%  { left: 0%;   top: 50%;  transform: translate(-50%, -50%) scale(1); }
    100% { left: 0%;   top: 0%;   transform: translate(-50%, -50%) scale(.78); }
  }

  @keyframes pulseDot {
    from { filter: blur(0.25px) drop-shadow(0 0 8px rgba(255,246,221,0.92)) drop-shadow(0 0 16px rgba(255,227,160,0.65)); }
    to   { filter: blur(0.15px) drop-shadow(0 0 12px rgba(255,252,240,1)) drop-shadow(0 0 24px rgba(255,227,160,0.92)); }
  }
</style>
</head>
<body>
  <div class="divider"></div>
  <div id="jumpWrap" class="jump-wrap">
    <button class="btn" onclick="(async()=>{try{const f=window.setChatMessages??window.parent?.setChatMessages;const w=document.getElementById('jumpWrap');const o=document.getElementById('jumpRing');if(w)w.className='jump-wrap is-jumping';if(o)o.className='jump-ring show';await new Promise(r=>setTimeout(r,650));if(typeof f==='function')await f([{message_id:0,swipe_id:0}]);}catch(e){console.error(e);}})()" >
      返回剧情索引
    </button>
    <div id="jumpRing" class="jump-ring"></div>
  </div>
</body>
</html>
